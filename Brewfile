# Dotfiles
brew "stow"

# Core CLI
brew "git"
brew "git-filter-repo"
brew "gh"
brew "lazygit"

# Shell / prompt
brew "spaceship"
brew "lsd"

# Search / nav
brew "ripgrep"
brew "fd"
brew "fzf"
brew "tree"
brew "wget"

# Editor
brew "neovim"

# Node.js (TypeScript). pnpm itself comes from corepack, bundled with node,
# not a separate brew formula -- see install.sh.
brew "node"

# Python. uv manages venvs/packages; pyenv manages installed interpreter
# versions. pipx is for globally-installed Python CLI tools (e.g. poetry).
brew "uv"
brew "pyenv"
brew "pipx"

# AI coding tools. Claude Code is installed separately via its native
# installer in install.sh, not brew -- see that script for why.
brew "opencode"
cask "cmux"

# Terminal
cask "ghostty"
cask "font-symbols-only-nerd-font"
